#!/usr/bin/env bash
# claude-local – Claude Code mit Modell aus LM Studio oder Unsloth starten
set -u

LM=http://192.168.23.100:1234
US=http://192.168.23.100:8888
: "${UNSLOTH_API_KEY:?UNSLOTH_API_KEY nicht gesetzt}"

mapfile -t items < <(
  {
    curl -sf --max-time 3 "$LM/v1/models" \
      | jq -r '.data[].id | select(test("embed") | not) | "lm\t" + .'
    curl -sf --max-time 3 -H "Authorization: Bearer $UNSLOTH_API_KEY" "$US/v1/models" \
      | jq -r '.data[].id | select(test("embed") | not) | "us\t" + .'
  } 2>/dev/null
)
[ "${#items[@]}" -gt 0 ] || { echo "kein Server erreichbar" >&2; exit 1; }

PS3="Modell: "
select item in "${items[@]}"; do [ -n "$item" ] && break; done
[ -n "${item:-}" ] || exit 1

srv=${item%%$'\t'*}
model=${item#*$'\t'}

if [ "$srv" = lm ]; then
  export ANTHROPIC_BASE_URL=$LM ANTHROPIC_AUTH_TOKEN=lmstudio
else
  export ANTHROPIC_BASE_URL=$US ANTHROPIC_AUTH_TOKEN=$UNSLOTH_API_KEY
fi

export ANTHROPIC_MODEL=$model
export ANTHROPIC_DEFAULT_HAIKU_MODEL=$model
export ANTHROPIC_DEFAULT_SONNET_MODEL=$model
export ANTHROPIC_DEFAULT_OPUS_MODEL=$model

exec claude "$@"
